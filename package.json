{
  "name": "@opencore-mes/juris-kit",
  "version": "0.91.6",
  "description": "A framework for server-rendered web apps whose pages stay live: no build step, no runtime dependency",
  "keywords": [
    "framework",
    "server-rendering",
    "live-queries",
    "reactive",
    "no-build"
  ],
  "homepage": "https://github.com/opencore-mes/juris-kit#readme",
  "license": "Apache-2.0",
  "author": "Resti Guay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opencore-mes/juris-kit.git"
  },
  "bugs": {
    "url": "https://github.com/opencore-mes/juris-kit/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./juris.js",
  "exports": {
    ".": "./juris.js",
    "./*": "./*"
  },
  "files": [
    "*.js",
    "server/",
    "README.md",
    "REFERENCE.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\""
  }
}
